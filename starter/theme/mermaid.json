{
  "theme": "base",
  "look": "classic",
  "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
  "themeVariables": {
    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "fontSize": "14px",
    "darkMode": false,
    "background": "var(--bg)",
    "primaryColor": "var(--bg)",
    "primaryTextColor": "var(--fg)",
    "primaryBorderColor": "var(--fg)",
    "secondaryColor": "var(--bg-inset)",
    "tertiaryColor": "var(--bg-inset)",
    "lineColor": "var(--fg-muted)",
    "textColor": "var(--fg)",
    "mainBkg": "var(--bg)",
    "nodeBorder": "var(--fg)",
    "clusterBkg": "var(--bg-inset)",
    "clusterBorder": "var(--rule)",
    "titleColor": "var(--fg)",
    "edgeLabelBackground": "var(--bg)",
    "actorBkg": "var(--bg)",
    "actorBorder": "var(--fg)",
    "actorTextColor": "var(--fg)",
    "actorLineColor": "var(--rule)",
    "signalColor": "var(--fg-muted)",
    "signalTextColor": "var(--fg)",
    "noteBkgColor": "var(--bg-inset)",
    "noteBorderColor": "var(--accent)",
    "noteTextColor": "var(--fg)"
  },
  "flowchart": {"htmlLabels": false, "curve": "linear"}
}
